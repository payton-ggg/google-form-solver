{
  "manifest_version": 3,
  "name": "Google Forms AI Solver (Gemini)",
  "version": "1.0.0",
  "description": "Автоматическое решение заданий и объяснение ответов в Google Формах с помощью Google Gemini AI",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Forms AI Solver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
